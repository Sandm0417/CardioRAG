# Local keys only. Copy to `.env` and fill in values on your machine.
# Never commit `.env`. This file contains placeholders only.

# Required for generation / LLM judging
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional second key for rate-limit rotation
DEEPSEEK_API_KEY_2=

# Required only if you rebuild the LightRAG index
ARK_API_KEY=
ARK_EMBEDDING_ENDPOINT=
ARK_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
